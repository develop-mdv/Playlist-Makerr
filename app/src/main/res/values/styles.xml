<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar Title Style -->
    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/toolbarTitleColor</item>
    </style>

    <!-- Big Button Style for Main Screen -->
    <style name="ButtonBig" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">220dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/buttonTextColor</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">?attr/buttonIconColor</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Settings Item Style -->
    <style name="SettingsItem" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">19sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/settingsItemTextColor</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">?attr/settingsItemIconColor</item>
    </style>
</resources>

