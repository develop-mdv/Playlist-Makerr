<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Playlist_maker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/yp_blue</item>
        <item name="colorPrimaryVariant">@color/yp_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/yp_blue</item>
        <item name="colorSecondaryVariant">@color/yp_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/yp_blue</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <!-- Custom color attributes -->
        <item name="toolbarTitleColor">@color/toolbar_title_light</item>
        <item name="buttonTextColor">@color/button_text_light</item>
        <item name="buttonIconColor">@color/button_icon_light</item>
        <item name="settingsItemTextColor">@color/settings_item_text_light</item>
        <item name="settingsItemIconColor">@color/settings_item_icon_light</item>
    </style>
</resources>