<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="13dp"
    android:paddingEnd="13dp">

    <ImageView
        android:id="@+id/playlistCover"
        android:layout_width="@dimen/playlist_bs_item_cover_size"
        android:layout_height="@dimen/playlist_bs_item_cover_size"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playlistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="1"
            android:textColor="@color/playlist_item_name_text"
            android:textSize="16sp"
            tools:text="Best Playlist" />

        <TextView
            android:id="@+id/playlistTrackCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="1"
            android:textColor="@color/track_subtitle_text"
            android:textSize="11sp"
            tools:text="0 треков" />

    </LinearLayout>

</LinearLayout>
