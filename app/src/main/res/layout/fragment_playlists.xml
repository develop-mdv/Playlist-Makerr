<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newPlaylistButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_new_playlist_margin_top"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/new_playlist"
        android:textAllCaps="false"
        android:textColor="@color/new_playlist_button_text_light"
        android:textSize="@dimen/library_new_playlist_text_size"
        android:paddingHorizontal="@dimen/library_new_playlist_padding_horizontal"
        android:paddingVertical="@dimen/library_new_playlist_padding_vertical"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/new_playlist_button_bg_light"
        app:cornerRadius="@dimen/library_new_playlist_corner_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/placeholderImage"
        android:layout_width="@dimen/placeholder_image_size"
        android:layout_height="@dimen/placeholder_image_size"
        android:layout_marginTop="@dimen/library_placeholder_margin_top"
        android:src="@drawable/il_nothing_found"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newPlaylistButton" />

    <TextView
        android:id="@+id/placeholderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_placeholder_text_margin_top"
        android:fontFamily="@font/ys_display_medium"
        android:gravity="center"
        android:text="@string/playlists_empty"
        android:textColor="@color/placeholder_text_color"
        android:textSize="@dimen/placeholder_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeholderImage" />

</androidx.constraintlayout.widget.ConstraintLayout>
