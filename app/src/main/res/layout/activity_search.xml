<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:title="@string/search"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="@color/toolbar_title_settings_light"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/toolbar_title_settings_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/search_field_vertical_padding"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_field_height"
                android:hint="@string/search"
                android:textColorHint="@color/search_field_hint"
                android:textColor="@color/search_field_text_light"
                android:background="@drawable/search_field_background"
                android:paddingStart="@dimen/search_field_icon_start_padding"
                android:paddingEnd="@dimen/search_field_padding_end"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/SearchFieldTextAppearance"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/search_field_icon_drawable_padding"
                app:drawableTint="@color/search_field_icon" />

            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="@dimen/search_field_height"
                android:layout_height="@dimen/search_field_height"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/search"
                android:padding="10dp"
                android:layout_marginEnd="@dimen/search_field_clear_margin_end"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/search_field_icon" />

        </FrameLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>

