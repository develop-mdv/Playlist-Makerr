<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:title="@string/search"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="@color/toolbar_title_settings_light"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/toolbar_title_settings_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/search_field_vertical_padding"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_field_height"
                android:hint="@string/search"
                android:textColorHint="@color/search_field_hint"
                android:textColor="@color/search_field_text_light"
                android:background="@drawable/search_field_background"
                android:paddingStart="@dimen/search_field_icon_start_padding"
                android:paddingEnd="@dimen/search_field_padding_end"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/SearchFieldTextAppearance"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/search_field_icon_drawable_padding"
                app:drawableTint="@color/search_field_icon" />

            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="@dimen/search_field_height"
                android:layout_height="@dimen/search_field_height"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/search"
                android:padding="10dp"
                android:layout_marginEnd="@dimen/search_field_clear_margin_end"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/search_field_icon" />

        </FrameLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/history_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_history_title"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/screen_padding"
                android:text="@string/search_history_title"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="19sp"
                android:textColor="@color/track_title_text" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/ys_display_medium"
                android:text="@string/clear_history"
                android:textAllCaps="false"
                android:textColor="@color/placeholder_button_text"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                app:backgroundTint="@color/placeholder_button_bg"
                app:cornerRadius="54dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/placeholder_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_placeholder"
            android:layout_width="@dimen/placeholder_image_size"
            android:layout_height="@dimen/placeholder_image_size"
            android:layout_marginTop="@dimen/placeholder_image_margin_top"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/placeholder_margin_horizontal"
            android:layout_marginTop="@dimen/placeholder_text_margin_top"
            android:fontFamily="@font/ys_display_medium"
            android:gravity="center"
            android:textColor="@color/placeholder_text_color"
            android:textSize="@dimen/placeholder_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/placeholder_button_margin_top"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/refresh"
            android:textAllCaps="false"
            android:textColor="@color/placeholder_button_text"
            android:textSize="@dimen/placeholder_button_text_size"
            android:paddingHorizontal="@dimen/placeholder_button_padding_horizontal"
            android:paddingVertical="@dimen/placeholder_button_padding_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            app:backgroundTint="@color/placeholder_button_bg"
            app:cornerRadius="@dimen/placeholder_button_corner_radius" />

    </LinearLayout>

</LinearLayout>
